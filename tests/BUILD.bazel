"""Tests for rules_tekton.

- Analysis test verifies the macro instantiates cleanly.
- Smoke composition: kind cluster + Tekton Pipelines (4 Deployments
  across 2 namespaces). Smoke applies a Task + TaskRun fixture
  (busybox echo step), waits for the TaskRun's Succeeded condition,
  asserts True. Proves controller reconciler + webhook + Pod
  creation/completion + status update end-to-end.
"""

load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_tekton//:defs.bzl", "tekton_health_check", "tekton_install")
load(":analysis_tests.bzl", "tekton_install_test_suite")

# ---- analysis ---------------------------------------------------------------

tekton_install_test_suite(name = "tekton_install_analysis")

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.35")

kind_health_check(name = "cluster_health", cluster = ":cluster")

itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

tekton_install(
    name = "tekton_install_bin",
    tags = ["manual"],
)

tekton_health_check(
    name = "tekton_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "tekton_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":tekton_install_bin"],
)

sh_binary(
    name = "tekton_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":tekton_health_bin"],
)

itest_service(
    name = "tekton_svc",
    exe = ":tekton_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":tekton_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    data = ["fixtures/smoke-task.yaml"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":tekton_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
