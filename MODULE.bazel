"""rules_tekton — hermetic Tekton Pipelines install for Bazel test compositions."""

module(
    name = "rules_tekton",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "rules_kubectl", version = "0.2.0")
git_override(
    module_name = "rules_kubectl",
    remote = "https://github.com/collider-bazel-extensions/rules_kubectl",
    commit = "81b60ab80df46b64c612f2576ffef0a7af98ccb6",  # v0.2.0 — apply_namespace_flag
)

# ---- dev-only: smoke composition --------------------------------------------
# Consumers do NOT inherit any of these. The in-tree smoke test composes a
# kind cluster, Tekton via this rule set, and a Task + TaskRun reconciliation
# assertion against a local busybox echo step.
bazel_dep(name = "rules_itest", version = "0.0.52", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

bazel_dep(name = "rules_kind", version = "0.2.1", dev_dependency = True)
git_override(
    module_name = "rules_kind",
    remote = "https://github.com/collider-bazel-extensions/rules_kind",
    commit = "b3f1b1d4215b3793ee2d5673f552141c44af126d",  # v0.2.1 — reaper survives the end of the test; podman uses the real image store
)
